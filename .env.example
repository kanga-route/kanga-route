# Kanga-Route runtime configuration
#
# Copy this file to .env and keep that file private:
#   cp .env.example .env
#   chmod 600 .env

# HubSpot private-app token. This is required for a run; leaving it empty makes
# the engine fail closed during startup validation, before CRM or SMTP work.
HUBSPOT_ACCESS_TOKEN=

# Run and retention policy. BATCH_SIZE caps contacts processed per run;
# REVERIFY_AFTER_DAYS selects contacts whose last result is stale; and
# UNKNOWN_RETRY_AFTER_HOURS prevents transient results from monopolizing each
# scheduled batch while keeping them eligible for a later retry.
# CACHE_TTL_DAYS controls how long verification results stay cacheable.
BATCH_SIZE=100
REVERIFY_AFTER_DAYS=30
UNKNOWN_RETRY_AFTER_HOURS=48
CACHE_TTL_DAYS=30

# SMTP identity used only for verification handshakes (Kanga-Route does not send
# message bodies). These reserved .invalid placeholders are intentionally not a
# real sender identity. Replace both values with a hostname and address you own,
# and configure matching forward/reverse DNS and SPF, before a production run.
SMTP_HELO_DOMAIN=verifier.example.invalid
SMTP_MAIL_FROM=verify@example.invalid

# Cache mode. Local mode uses the bundled DynamoDB Local container. For managed
# DynamoDB, set USE_LOCAL_DB=false and leave DYNAMODB_ENDPOINT_URL empty.
USE_LOCAL_DB=true
DYNAMODB_ENDPOINT_URL=
DYNAMODB_TABLE_NAME=KangaRouteCache
DYNAMODB_LOCAL_PORT=8000

# AWS region applies to both modes. Local mode injects non-secret signing values
# inside the engine container. Cloud appliance mode requires an attached EC2
# instance role; Compose deliberately does not forward host static credentials.
AWS_REGION=us-east-1

# Browser console. It is disabled by default and, when enabled, is published
# only on the host loopback interface for SSM port forwarding. These controls
# bound one process; they are not a substitute for the future TLS/auth design.
ENABLE_WEB_UI=false
KANGA_ROUTE_WEB_PORT=8080
WEB_VERIFY_TIMEOUT_SECONDS=45
WEB_MAX_CONCURRENT=2
WEB_REQUESTS_PER_MINUTE=30
