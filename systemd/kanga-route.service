[Unit]
Description=Kanga-Route Containerized Virtual Appliance Stack
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/kanga-route
ExecStart=/usr/bin/docker compose up -d dynamodb-local
ExecStop=/usr/bin/docker compose down

[Install]
WantedBy=multi-user.target
